---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { localePath, useTranslations, type Lang } from '../i18n/ui';

// A single 404 serves both languages, so it shows the message in each of them.
const langs: Lang[] = ['en', 'de'];
const t = useTranslations('en');
const tDe = useTranslations('de');
---

<BaseLayout title={t('meta.404.title')} description={t('meta.404.description')} lang="en" path="/">
  <SiteHeader lang="en" />
  <main id="main-content" class="not-found shell">
    <p class="eyebrow"><span></span> {t('404.eyebrow')}</p>
    <h1>{t('404.titleLead')} <em>{t('404.titleAccent')}</em></h1>
    <p>{t('404.text')}</p>
    <p lang="de">{tDe('404.text')}</p>
    <div class="hero__actions">
      {langs.map((code) => (
        <a class="button button--primary" href={localePath(code, '/')} lang={code}>
          {useTranslations(code)('404.cta')}
        </a>
      ))}
    </div>
  </main>
  <SiteFooter lang="en" />
</BaseLayout>
