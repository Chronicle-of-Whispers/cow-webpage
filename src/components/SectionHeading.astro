---
interface Props {
  id?: string;
  eyebrow: string;
  title: string;
  text?: string;
  align?: 'left' | 'center';
}

const { id, eyebrow, title, text, align = 'left' } = Astro.props;
---

<div class:list={['section-heading', `section-heading--${align}`]}>
  <p class="eyebrow"><span></span> {eyebrow}</p>
  <h2 id={id}>{title}</h2>
  {text && <p>{text}</p>}
</div>
